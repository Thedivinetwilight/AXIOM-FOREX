# Local secrets and environments
.env
.env.*
!.env.example
.venv/
venv/

# Python and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Runtime state, exports, and downloaded market data
#
# SQLite creates up to four files per database: the database itself, a write-
# ahead log (-wal), its shared-memory index (-shm), and a rollback journal
# (-journal). All four are live runtime state that changes on every write.
# Committing a sidecar leaks ledger history into Git and can give a reader a
# view of the database that never actually existed, so every suffix is ignored.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
logs/
data/cache/
data/history/
data/universe/
data/datasets/
# The catalog's evaluation record and the paper test's ledger/state.
data/catalog/
# The AXIOM-managed Kronos install (weights, tokenizer, pinned source tree). It is
# fetched by an explicit Install action and never belongs in Git.
data/kronos/
results/*
!results/.gitkeep

# Local lock files
*.paper.lock

# Local MT5 configuration (never contains the password; the password lives in the OS vault)
mt5_settings.local.json
*.local.json
